# Citation Firewall — environment

# Anthropic API key (server-side only; never exposed to the browser).
# Used for the adversarial council (Sonnet 4.6) and the Sutra synthesis (Opus 4.8).
ANTHROPIC_API_KEY=sk-ant-...

# CourtListener API token (https://www.courtlistener.com/profile/tokens/).
# Used by the verifier to confirm every citation against real court opinions.
COURTLISTENER_TOKEN=...

# Port the single Hono process listens on. Defaults to 3000.
PORT=3000
