{
  "name": "citation-firewall",
  "version": "1.0.0",
  "description": "An adversarial AI council that attacks a legal brief while every cited authority is checked against CourtListener's live database of real court opinions before it reaches the lawyer.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run --dir test",
    "e2e": "vitest run --dir e2e --testTimeout=120000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
